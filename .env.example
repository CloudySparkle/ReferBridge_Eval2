# ==============================================================================
# REFERBRIDGE — ENVIRONMENT VARIABLES CONFIGURATION (EVALUATION 1–2)
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Never commit '.env' containing real secrets to version control.

# ------------------------------------------------------------------------------
# 1. SUPABASE BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# Use the 'anon' public key ONLY. Never put your 'service_role' secret key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS & ROUTES API CONFIGURATION
# ------------------------------------------------------------------------------
# Enable the following APIs in your Google Cloud Console:
# 1. Maps JavaScript API (for rendering interactive map and hospital markers)
# 2. Routes API / Directions API (for hospital-to-hospital route calculation)
# 3. Geocoding API (for hospital address coordinate resolution)
# Restrict this key by HTTP Referrer (e.g. http://localhost:3000/*)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
